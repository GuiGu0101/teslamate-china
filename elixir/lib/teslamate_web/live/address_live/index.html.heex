<nav class="breadcrumb" aria-label="breadcrumbs">
  <ul>
    <li><.link navigate={~p"/"}><%= gettext("Home") %></.link></li>
    <li class="is-active">
      <.link navigate={~p"/address"}><%= gettext("Addresses") %></.link>
    </li>
  </ul>
</nav>

<table class="table is-fullwidth">
  <thead class="is-hidden-mobile">
    <tr>
      <th><%= gettext("Name") %></th>
      <th><%= gettext("Position") %></th>
      <%!-- <th><%= gettext("Radius") %></th> --%>
      <th></th>
    </tr>
  </thead>
  <tbody style="font-variant-numeric: tabular-nums;">
    <%= for address <- @addresses do %>
      <tr>
        <td class="has-text-weight-medium is-truncated" style="min-width: 0; max-width: 180px">
          <%= address.name %>
        </td>
        <td class="is-hidden-mobile has-text-weight-light" style="width: 40%">
          <%= address.state %><%= address.county %><%= address.city %><%= address.neighbourhood %><%= address.road %><%= address.house_number %>
        </td>
        <%!-- <td class="is-hidden-mobile has-text-weight-light" style="width: 10%">
          <%= case @unit_of_length do
            :ft -> address.radius |> Convert.m_to_ft() |> round()
            :m -> address.radius |> round()
          end %> <%= @unit_of_length %>
        </td> --%>
        <td>
          <div class="field is-grouped is-pulled-right">
            <p class="control">
              <.link
                navigate={Routes.live_path(@socket, TeslaMateWeb.AddressLive.Form, address, [])}
                class="button is-info is-small is-inverted is-light"
                replace={false}
                target="_blank"
              >
                编辑
              </.link>
            </p>
             <p class="control">
              <%= link(raw("<span class='icon'><span class='mdi mdi-trash-can'></span></span>"),
                to: "#",
                phx_hook: "ConfirmAddressDeletion",
                data: [
                  id: address.id,
                  msg: gettext("Delete '%{address}'?", address: address.name)
                ],
                type: "button",
                id: "delete_#{address.id}",
                class: "button is-danger is-small is-inverted is-light"
              ) %>
            </p>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
