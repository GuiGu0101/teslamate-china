{<<"links">>,[{<<"GitHub">>,<<"https://github.com/hauleth/phoenix_bakery">>}]}.
{<<"name">>,<<"phoenix_bakery">>}.
{<<"version">>,<<"1.0.0">>}.
{<<"description">>,<<"Better compression for your Phoenix assets.">>}.
{<<"elixir">>,<<"~> 1.11">>}.
{<<"app">>,<<"phoenix_bakery">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"phoenix">>},
   {<<"app">>,<<"phoenix">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.6">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"brotli">>},
   {<<"app">>,<<"brotli">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 0.3.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"ezstd">>},
   {<<"app">>,<<"ezstd">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"files">>,
 [<<"lib">>,<<"lib/phoenix_bakery.ex">>,<<"lib/phoenix_bakery">>,
  <<"lib/phoenix_bakery/gzip.ex">>,<<"lib/phoenix_bakery/zstd.ex">>,
  <<"lib/phoenix_bakery/brotli.ex">>,<<".formatter.exs">>,<<"mix.exs">>,
  <<"README.md">>,<<"LICENSE">>,<<"CHANGELOG.md">>]}.
{<<"build_tools">>,[<<"mix">>]}.
